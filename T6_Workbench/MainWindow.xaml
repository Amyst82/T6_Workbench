<Window x:Class="T6_Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T6_Workbench"
        xmlns:svg="https://github.com/dotnetprojects/SVGImage"
        xmlns:AMUI="clr-namespace:AMUI;assembly=AMUI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:sys2="clr-namespace:System;assembly=System"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000" MinHeight="650" MinWidth="1000" AllowsTransparency="True" WindowStyle="None" Background="Transparent" Foreground="{local:UIColor Foreground}" FontSize="16"
        FontFamily="./Resources/#SF Pro Rounded Regular" x:Name="T6WorkbenchMainWindow" DataContext="{x:Static local:MainViewModel.WorkbenchViewModel}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="11" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

            </ResourceDictionary.MergedDictionaries>
            <x:Static x:Key="empty" Member="sys:String.Empty" />
            <Visibility x:Key="Collapsed">Collapsed</Visibility>
            <Visibility x:Key="Visible">Visible</Visibility>
            <sys:Boolean x:Key="BoolTrue">True</sys:Boolean>
            <sys:Boolean x:Key="BoolFalse">False</sys:Boolean>
            <sys:Int32 x:Key="IntZero">0</sys:Int32>
            <WindowState x:Key="WndMaximized">Maximized</WindowState>
            <WindowState x:Key="WndNormal">Normal</WindowState>
            <Style x:Key="ContextMenuStyle" TargetType="{x:Type ContextMenu}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="{local:UIColor Gray4}" CornerRadius="8" Padding="5" Margin="5" MinWidth="200">
                                <StackPanel IsItemsHost="True"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="BackGroundBorder" Background="{local:UIColor Gray4}" CornerRadius="5" Padding="2,2,2,2" Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter ContentSource="Icon" RecognizesAccessKey="True"/>
                                    <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="14" Margin="5,0,5,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="BackGroundBorder" Value="{local:UIColor Gray5}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RecentProjectListViewItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="ToolTip" Value="{Binding ProjectPath}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="RecentProjStyleBackGroundBorder" Height="50" Background="{local:UIColor Gray2}" Margin="2" CornerRadius="8" BorderThickness="2" BorderBrush="{local:UIColor Gray2}" MouseDown="RecentProjStyleBackGroundBorder_MouseDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <TextBlock x:Name="ProjNameLabel" Text="{Binding Name}" FontSize="16" Foreground="{local:UIColor Foreground}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastOpenedAt, StringFormat='Last opened: {0:g}'}" FontSize="12" Foreground="{local:UIColor Gray6}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="RecentProjStyleBackGroundBorder" Value="{local:UIColor Gray5}"/>
                                    <Setter Property="BorderBrush" TargetName="RecentProjStyleBackGroundBorder" Value="{local:UIColor Gray5}"/>
                                    <Setter Property="TextElement.Foreground" TargetName="ProjNameLabel" Value="{local:UIColor Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu Style="{StaticResource ContextMenuStyle}" Background="{local:UIColor Gray4}">
                            <MenuItem Header="Show in explorer" Foreground="{local:UIColor Foreground}">
                                <MenuItem.Icon>
                                    <svg:SVGImage UriSource="./Resources/search-folder-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hide from recents" Foreground="{local:UIColor Foreground}">
                                <MenuItem.Icon>
                                    <svg:SVGImage UriSource="./Resources/eye-off-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Delete" Foreground="{local:UIColor Danger}">
                                <MenuItem.Icon>
                                    <svg:SVGImage UriSource="./Resources/trash-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{local:UIColor Gray0}" CornerRadius="10" Margin="5">
        <Grid x:Name="MainGrid" Background="Transparent" MouseMove="MainGrid_MouseMove" >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="FooterRow">
                    <RowDefinition.Height>
                        <MultiBinding Converter="{AMUI:ConvertersME Converter=Expression}" ConverterParameter="A = B">
                            <Binding Path="WindowState" ElementName="T6WorkbenchMainWindow"/>
                            <!-- A -->
                            <Binding Source="{x:Static WindowState.Maximized}"/>
                            <Binding>
                                <!-- True value -->
                                <Binding.Source>
                                    <GridLength>50</GridLength>
                                </Binding.Source>
                            </Binding>
                            <Binding>
                                <!-- False value -->
                                <Binding.Source>
                                    <GridLength>0</GridLength>
                                </Binding.Source>
                            </Binding>
                        </MultiBinding>
                    </RowDefinition.Height>
                </RowDefinition>
                <!--Just to fix the full screen displaying issues-->
            </Grid.RowDefinitions>
            <Grid x:Name="ToolBarHead" Background="Transparent" Margin="5,5,5,0" MouseDown="ToolBarHead_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition MinWidth="300" MaxWidth="500"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{AMUI:ConditionME IF={Binding SelectedIndex, ElementName=TabsControl}, ComparingMode=NotEquals, TO=0, Then={StaticResource Visible}, Else={StaticResource Collapsed}}">
                        <AMUI:Button82 x:Name="HideDockButton" Accent82="{local:UIColor Gray0}" Width="35" Height="35" Margin="5">
                            <svg:SVGImage UriSource="./Resources/dock-left-svgrepo-com.svg" Width="18" Height="18" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:Button82>
                        <Border x:Name="ProjCardBorder" CornerRadius="8" Margin="5" Height="35" VerticalAlignment="Center" ToolTip="{Binding CurrentProject.ProjectPath}">
                            <Border.Background>
                                <MultiBinding Converter="{AMUI:ConvertersME Converter=Expression}" ConverterParameter="A = B">
                                    <Binding Path="IsChecked" ElementName="ProjDropdownMenuCheckBoxButton"/>
                                    <!-- A -->
                                    <Binding>
                                        <Binding.Source>
                                            <sys:Boolean>True</sys:Boolean>
                                        </Binding.Source>
                                    </Binding>
                                    <local:UIColorExtension Name="Gray4"/>
                                    <Binding Source="{x:Static Brushes.Transparent}"/>
                                </MultiBinding>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock Margin="10,5,5,5" Text="{AMUI:StringME InputString={Binding CurrentProject.Name, FallbackValue='No project open'}, MaxLength=25}" VerticalAlignment="Center" Foreground="{local:UIColor Foreground}" FontSize="16"/>
                                <AMUI:CustomizableCheckBox82 x:Name="ProjDropdownMenuCheckBoxButton" Width="25" Height="25" Content="{x:Null}" Margin="5" Cursor="Hand" Foreground="{local:UIColor Gray6}" OutlineThickness="5" IsChecked="False">
                                    <AMUI:CustomizableCheckBox82.UncheckedContent>
                                        <TextBlock Text="•••" FontSize="12" Foreground="{local:UIColor Gray6}" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </AMUI:CustomizableCheckBox82.UncheckedContent>
                                    <AMUI:CustomizableCheckBox82.CheckedContent>
                                        <Viewbox Margin="6" Width="12" Height="12" RenderTransformOrigin="0.5,0.5">
                                            <Viewbox.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform/>
                                                    <SkewTransform/>
                                                    <RotateTransform Angle="-180"/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </Viewbox.RenderTransform>
                                            <Path Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{local:UIColor Gray6}" StrokeThickness="2" StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round" Data="M12.25 5.75 8 10.25l-4.25-4.5"/>
                                        </Viewbox>
                                    </AMUI:CustomizableCheckBox82.CheckedContent>
                                </AMUI:CustomizableCheckBox82>
                                <Popup Placement="Bottom" IsOpen="{Binding ElementName=ProjDropdownMenuCheckBoxButton, Path=IsChecked, Mode=TwoWay}" VerticalOffset="5" HorizontalAlignment="Center" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                                    <Grid SnapsToDevicePixels="True" MinWidth="{Binding ElementName=ProjCardBorder,Path=ActualWidth}" MinHeight="70" MaxHeight="520">
                                        <Border Background="{local:UIColor Gray4}" CornerRadius="8" Padding="5" Margin="0">
                                            <StackPanel Orientation="Vertical" Margin="5">
                                                <ItemsControl>
                                                    <TextBlock Text="Project" Foreground="{local:UIColor Gray6}" FontSize="13" Margin="5"/>
                                                    <MenuItem Header="New project" Foreground="{local:UIColor Foreground}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/add-file-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="OpenProject_Click" IsEnabled="{Binding CanOpenProject}" Header="Open project" Foreground="{local:UIColor Foreground}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/folder-open-svgrepo-com.svg" Width="16" Height="16" Margin="5,10,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Show in explorer" Foreground="{local:UIColor Foreground}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/search-folder-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem x:Name="ProjSettingsMenuItem" Header="Settings" Foreground="{local:UIColor Foreground}" Click="ProjSettingsMenuItem_Click">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/gear-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Delete" Foreground="{local:UIColor Danger}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/trash-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <TextBlock Text="Workbench" Foreground="{local:UIColor Gray6}" FontSize="13" Margin="5"/>
                                                    <MenuItem Header="Home screen" Foreground="{local:UIColor Foreground}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/house-chimney-floor-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor Gray6Color}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Logs" Foreground="{local:UIColor Foreground}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/refresh-ccw-clock-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor Gray6Color}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="About" Foreground="{local:UIColor Foreground}">
                                                        <MenuItem.Icon>
                                                            <svg:SVGImage UriSource="./Resources/circle-information-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor Gray6Color}"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ItemsControl>                                               
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Popup>
                               
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid Background="Transparent" Grid.Column="1">
                    <AMUI:TextBox82 x:Name="SearchTextBox" Foreground="{local:UIColor Foreground}" CaretBrush="{local:UIColor Foreground}"  Margin="5,5,5,5" HintText="Search through assets..." OutlineThickness="1" Background82="{local:UIColor Gray1}" Accent82="{local:UIColor Gray3}" EdgeRoundness="8" Visibility="{AMUI:ConditionME IF={Binding SelectedIndex, ElementName=TabsControl}, ComparingMode=NotEquals, TO=0, Then={StaticResource Visible}, Else={StaticResource Collapsed}}">
                        <AMUI:TextBox82.IconPlaceholder>
                            <svg:SVGImage UriSource="./Resources/search-svgrepo-com.svg" Width="16" Height="16" Margin="10,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:TextBox82.IconPlaceholder>
                    </AMUI:TextBox82>
                </Grid>
                <Grid Grid.Column="2" Background="Transparent">
                    <AMUI:Button82 x:Name="BuildButton" Width="35" Height="35" HorizontalAlignment="Left" Margin="5" 
                                   Visibility="{AMUI:ConditionME IF={Binding SelectedIndex, ElementName=TabsControl}, ComparingMode=NotEquals, TO=0, Then={StaticResource Visible}, Else={StaticResource Collapsed}}" 
                                   EdgeRoundness="8" Accent82="{local:UIColor Gray1}" Border82="{local:UIColor Gray3}" OutlineThickness="1" ScaleUpOnHover="True" ScaleDownOnPress="True"
                                   ToolTipService.ShowOnDisabled="True" ToolTip="{AMUI:ConditionME IF={Binding CurrentProject.ProjectChangeCount, FallbackValue=0}, 
                                   ComparingMode=Greater, TO=0, Then={Binding CurrentProject.ProjectChangeCount, FallbackValue=0, StringFormat=Changes {0}}, 
                                   Else='No changes made', ElseType={x:Type sys:String}}">
                        <AMUI:Button82.IsEnabled>
                            <MultiBinding Converter="{AMUI:ConvertersME Converter=Expression}" ConverterParameter="A &gt; 0">
                                <Binding Path="CurrentProject.ProjectChangeCount"/>
                                <Binding>
                                    <Binding.Source>
                                        <sys:Boolean>True</sys:Boolean>
                                    </Binding.Source>
                                </Binding>
                                <Binding>
                                    <Binding.Source>
                                        <sys:Boolean>False</sys:Boolean>
                                    </Binding.Source>
                                </Binding>
                            </MultiBinding>
                        </AMUI:Button82.IsEnabled>
                        <AMUI:Button82.Content>
                            <svg:SVGImage Width="18" Height="18" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <svg:SVGImage.UriSource>
                                    <MultiBinding Converter="{AMUI:ConvertersME Converter=Expression}" ConverterParameter="A &gt; 0">
                                        <Binding Path="CurrentProject.ProjectChangeCount" FallbackValue="0" />
                                        <Binding>
                                            <Binding.Source>
                                                <sys2:Uri>./Resources/hammer-svgrepo-com.svg</sys2:Uri>
                                            </Binding.Source>
                                        </Binding>
                                        <Binding>
                                            <Binding.Source>
                                                <AMUI:RandomME>
                                                    <sys2:Uri>./Resources/thinking-face-svgrepo-com.svg</sys2:Uri>
                                                    <sys2:Uri>./Resources/face-with-symbols-on-mouth-svgrepo-com.svg</sys2:Uri>
                                                    <sys2:Uri>./Resources/face-with-tears-of-joy-svgrepo-com.svg</sys2:Uri>
                                                    <sys2:Uri>./Resources/fire-svgrepo-com.svg</sys2:Uri>
                                                    <sys2:Uri>./Resources/beer-mug-svgrepo-com.svg</sys2:Uri>
                                                </AMUI:RandomME>
                                            </Binding.Source>
                                        </Binding>
                                    </MultiBinding>
                                </svg:SVGImage.UriSource>
                            </svg:SVGImage>
                        </AMUI:Button82.Content>
                    </AMUI:Button82>
                    <Popup Placement="Bottom" IsOpen="{Binding ElementName=BuildButton, Path=IsChecked, Mode=TwoWay}" VerticalOffset="5" HorizontalAlignment="Center" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" StaysOpen="False">
                        <Grid SnapsToDevicePixels="True" MinWidth="220" MinHeight="70" MaxHeight="520">
                            <Border Background="{local:UIColor Gray4}" CornerRadius="8" Padding="5" Margin="0">
                                <StackPanel Orientation="Vertical" Margin="5">
                                    <ItemsControl>
                                        <MenuItem Header="Build for T6" Foreground="{local:UIColor Foreground}">
                                            <MenuItem.Icon>
                                                <svg:SVGImage UriSource="./Resources/hammer-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideFillColor="{local:UIColor AccentColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Build for T6 Redacted" Foreground="{local:UIColor Foreground}">
                                            <MenuItem.Icon>
                                                <svg:SVGImage UriSource="./Resources/hammer-svgrepo-com.svg" Width="16" Height="16" Margin="5,10,5,5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideFillColor="{local:UIColor AccentColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Build for T6 Redacted Standalone" Foreground="{local:UIColor Foreground}">
                                            <MenuItem.Icon>
                                                <svg:SVGImage UriSource="./Resources/hammer-svgrepo-com.svg" Width="16" Height="16" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideFillColor="{local:UIColor SuccessColor}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Popup>
                    <StackPanel x:Name="ControlButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                        <AMUI:Button82 x:Name="MinimizeWindowButton" Width="45" Click="MinimizeWindowButton_Click" EdgeRoundness="5,0,0,5" Accent82="{local:UIColor Gray0}" Border82="{local:UIColor Gray0}" ScaleUpOnHover="False" ScaleDownOnPress="False">
                            <svg:SVGImage UriSource="./Resources/window-minimize-svgrepo-com.svg" Width="11" Height="11" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <svg:SVGImage.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-180"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </svg:SVGImage.RenderTransform>
                            </svg:SVGImage>
                        </AMUI:Button82>
                        <AMUI:Button82 x:Name="MaximizeWindowButton" Width="45" Click="MaximizeWindowButton_Click" EdgeRoundness="0,0,0,0" Accent82="{local:UIColor Gray0}" Border82="{local:UIColor Gray0}" ScaleUpOnHover="False" ScaleDownOnPress="False">
                            <svg:SVGImage UriSource="./Resources/window-maximize-svgrepo-com.svg" Width="11" Height="11" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:Button82>
                        <AMUI:Button82 x:Name="CloseWindowButton"    Width="45" Click="CloseWindowButton_Click"    EdgeRoundness="0,5,5,0" Accent82="{local:UIColor Gray0}" Border82="{local:UIColor Gray0}" ScaleUpOnHover="False" ScaleDownOnPress="False">
                            <svg:SVGImage UriSource="./Resources/xmark-svgrepo-com.svg" Width="11" Height="11" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:Button82>
                    </StackPanel>
                </Grid>
            </Grid>
            <TabControl x:Name="TabsControl" Grid.Row="1" Background="{local:UIColor Gray0}" BorderThickness="0" TabStripPlacement="Bottom">
                <TabItem x:Name="HomeTab" Header="Home" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="0.1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="No recent projects" Foreground="{local:UIColor Gray5}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,50,0" Grid.RowSpan="2">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{AMUI:ConvertersME Converter=Expression}" ConverterParameter="A = 0">
                                    <Binding Path="RecentProjects.Count"/>
                                    <!-- A -->
                                    <Binding>
                                        <!-- True value -->
                                        <Binding.Source>
                                            <Visibility>Visible</Visibility>
                                        </Binding.Source>
                                    </Binding>
                                    <Binding>
                                        <!-- False value -->
                                        <Binding.Source>
                                            <Visibility>Collapsed</Visibility>
                                        </Binding.Source>
                                    </Binding>
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                        <ListBox x:Name="RecentProjectsListBox" HorizontalAlignment="Right" MinWidth="300" MaxHeight="400" Margin="0,0,20,0" Grid.RowSpan="2" VerticalAlignment="Center" 
                                  Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource RecentProjectListViewItemStyle}" Foreground="{local:UIColor Foreground}" ItemsSource="{Binding RecentProjects}">
                        </ListBox>

                        <Border Width="3" Grid.Column="1" Height="400" Background="{local:UIColor Gray1}" Grid.RowSpan="3" VerticalAlignment="Center"/>
                        <!--divider-->
                        <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Left" Margin="20,0,0,0" Grid.RowSpan="2">
                            <AMUI:Button82 x:Name="NewProjButton" Height="125" Width="125" Margin="5" Accent82="{local:UIColor Gray2}" Border82="{local:UIColor Gray2}" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200">
                                <StackPanel>
                                    <svg:SVGImage UriSource="./Resources/add-file-svgrepo-com.svg" Width="45" Height="45" Margin="12,5,5,10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="New project" Foreground="{local:UIColor Foreground}" FontSize="16"/>
                                </StackPanel>
                            </AMUI:Button82>
                            <AMUI:Button82 x:Name="OpenProjButton" Height="125" Width="125" Margin="5" Accent82="{local:UIColor Gray2}" Border82="{local:UIColor Gray2}" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200" Click="OpenProject_Click" IsEnabled="{Binding CanOpenProject}">
                                <StackPanel>
                                    <svg:SVGImage UriSource="./Resources/folder-open-svgrepo-com.svg" Width="55" Height="55" Margin="12,5,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open project" Foreground="{local:UIColor Foreground}" FontSize="16"/>
                                </StackPanel>
                            </AMUI:Button82>
                        </StackPanel>
                        <Border Grid.Column="2" Grid.Row="1" Margin="5,5,20,5" MaxHeight="37" HorizontalAlignment="Right" Background="{local:UIColor Gray2}" BorderBrush="{local:UIColor Gray4}" BorderThickness="1" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Margin="2" >
                                <AMUI:Button82 x:Name="SwitchThemeButton" IsChecked="True" Margin="5" Width="24" Height="24" Accent82="{local:UIColor Gray2}" Border82="{local:UIColor Gray2}" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200" Cursor="Hand" Click="SwitchThemeButton_Click">
                                    <svg:SVGImage UriSource="./Resources/thinking-face-svgrepo-com.svg" Width="16" Height="16" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </AMUI:Button82>
                                <AMUI:Button82 Margin="5" Width="24" Height="24" Accent82="{local:UIColor Gray2}" Border82="{local:UIColor Gray2}" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200" Cursor="Hand">
                                    <svg:SVGImage UriSource="./Resources/circle-information-svgrepo-com.svg" Width="16" Height="16" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor Gray6Color}"/>
                                </AMUI:Button82>
                                <AMUI:Button82 Margin="5" Width="24" Height="24" Accent82="{local:UIColor Gray2}" Border82="{local:UIColor Gray2}" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200" Cursor="Hand">
                                    <svg:SVGImage UriSource="./Resources/github-142-svgrepo-com.svg" Width="16" Height="16" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </AMUI:Button82>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem x:Name="MainTab" Header="Main" Visibility="Visible">
                    <Grid x:Name="MainTabGrid" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto">
                                <ColumnDefinition.MinWidth>
                                    <MultiBinding Converter="{AMUI:ExpressionConverter ReturnValue=True}" ConverterParameter="300 * A">
                                        <Binding ElementName="TreeViewDock" Path="IsVisible" />
                                    </MultiBinding>
                                </ColumnDefinition.MinWidth>
                                <ColumnDefinition.MaxWidth>
                                    <MultiBinding Converter="{AMUI:ExpressionConverter ReturnValue=True}" ConverterParameter="(A - B) * 0.5 * C">
                                        <Binding ElementName="MainTabGrid" Path="ActualWidth" />
                                        <Binding ElementName="MainTabGridSplitter" Path="ActualWidth" />
                                        <Binding ElementName="TreeViewDock" Path="IsVisible" />
                                    </MultiBinding>
                                </ColumnDefinition.MaxWidth>
                            </ColumnDefinition>
                            <ColumnDefinition Width="Auto"/>
                            <!--Splitter-->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="TreeViewDock" Background="{local:UIColor Gray1}" Grid.Column="0" Visibility="{Binding ElementName=HideDockButton, Path=IsChecked, Converter={AMUI:ConvertersME Converter=BoolToOppositeVisibility}}">
                            <!--Tree view-->
                        </Grid>
                        <GridSplitter x:Name="MainTabGridSplitter" Visibility="{Binding ElementName=TreeViewDock, Path=Visibility}" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{local:UIColor Gray1}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                        <Grid Background="{local:UIColor Gray2}" Grid.Column="2">
                            <!--Viewport-->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>
                            <Viewport3D x:Name="ModelViewport" Visibility="Visible" Grid.RowSpan="3">
                                <Viewport3D.Camera>
                                    <PerspectiveCamera Position="{Binding PreviewCamera.Position}" LookDirection="{Binding PreviewCamera.LookDirection}" UpDirection="{Binding PreviewCamera.UpDirection}" FieldOfView="{Binding PreviewCamera.FieldOfView}" />
                                </Viewport3D.Camera>
                            </Viewport3D>
                            <Image x:Name="TexturePreview" Visibility="Visible" Stretch="Uniform" Grid.Row="1" />
                            <Border MaxHeight="45" Background="{local:UIColor Gray3}" Margin="20,5,5,5" CornerRadius="8" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <AMUI:Button82 Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" Width="30" Margin="5">
                                        <svg:SVGImage UriSource="./Resources/undo-svgrepo-com.svg" Width="16" Height="16" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideFillColor="{local:UIColor Gray6Color}"/>
                                    </AMUI:Button82>
                                    <AMUI:Button82 Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" Width="30" Margin="5">
                                        <svg:SVGImage UriSource="./Resources/undo-svgrepo-com.svg" Width="16" Height="16" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideFillColor="{local:UIColor Gray6Color}" RenderTransformOrigin="0.5,0.5">
                                            <svg:SVGImage.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="-1"/>
                                                    <SkewTransform/>
                                                    <RotateTransform/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </svg:SVGImage.RenderTransform>
                                        </svg:SVGImage>
                                    </AMUI:Button82>
                                </StackPanel>
                            </Border>
                            <Border MaxHeight="45" Background="{local:UIColor Gray3}" Margin="20,5,5,5" CornerRadius="8" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <AMUI:Button82 Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" Width="30" Margin="5">
                                        <svg:SVGImage UriSource="./Resources/image-square-svgrepo-com.svg" Width="16" Height="16" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor Gray6Color}"/>
                                    </AMUI:Button82>
                                    <TextBlock Text="t6_wpn_dsr50_view_lod0.glb" Foreground="{local:UIColor Foreground}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="PreviewPlaceholder" Grid.RowSpan="3" IsHitTestVisible="False" Text="Open a project and select an asset" Foreground="{local:UIColor Gray6}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,20,0" >
                                <Border Margin="5,5,5,5" Background="{local:UIColor Gray4}" BorderBrush="{local:UIColor Gray5}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" ToolTip="{Binding Status.State}">
                                        <TextBlock Text="{Binding Status.Message}" Foreground="{local:UIColor Foreground}" FontSize="14" VerticalAlignment="Center" Margin="5,5,5,5"/>
                                        <svg:SVGImage UriSource="./Resources/xmark-svgrepo-com.svg" Width="12" Height="12" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor DangerColor}" Visibility="{Binding Status.IsError, Converter={AMUI:ConvertersME Converter=BoolToVisibility}}"/>
                                        <svg:SVGImage UriSource="./Resources/warning-symbol-svgrepo-com.svg" Width="16" Height="16" Margin="5,5,5,2" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideFillColor="{local:UIColor WarningColor}" Visibility="{Binding Status.IsBuiltWithWarnings, Converter={AMUI:ConvertersME Converter=BoolToVisibility}}"/>
                                        <svg:SVGImage UriSource="./Resources/check-svgrepo-com.svg" Width="16" Height="16" Margin="5,5,5,0" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor SuccessColor}" Visibility="{Binding Status.IsBuilt, Converter={AMUI:ConvertersME Converter=BoolToVisibility}}"/>
                                        <AMUI:ArcProgressBar82 Width="16" Height="16" Margin="5" DoneCheckMark="False" Border82="{local:UIColor Gray5}" Accent82="{local:UIColor Accent}" StrokeWidth="65" Value="26" IsIndeterminate="True" Visibility="{Binding Status.IsRunning, Converter={AMUI:ConvertersME Converter=BoolToVisibility}}"/>
                                    </StackPanel>
                                </Border>
                                <AMUI:Button82 x:Name="CancelButton" Content="Cancel" Width="75" Height="35" Margin="5,5,5,5" Foreground="{local:UIColor Gray0}" Accent82="{local:UIColor Danger}" Visibility="{Binding Status.IsRunning, Converter={AMUI:ConvertersME Converter=BoolToVisibility}}"/>
                                <AMUI:Button82 x:Name="OpenButton" Width="120" Height="37" Margin="5,5,5,5" Foreground="{local:UIColor Foreground}" Accent82="{local:UIColor Gray5}" Visibility="{Binding CanOpenResult, Converter={AMUI:ConvertersME Converter=BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <svg:SVGImage UriSource="./Resources/external-link-svgrepo-com.svg" Width="14" Height="14" Margin="5,5,10,5" HorizontalAlignment="Center" VerticalAlignment="Center" OverrideStrokeColor="{local:UIColor ForegroundColor}"/>
                                        <TextBlock Text="Open result" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    </StackPanel>
                                </AMUI:Button82>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="SettingsTab" Header="Settings" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{local:UIColor Gray0}">
                        <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Stretch">
                            <TextBlock Text="Settings" FontSize="20" Foreground="{local:UIColor Foreground}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding StateStorageError}" Foreground="{local:UIColor Danger}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="OAT tools folder" Foreground="{local:UIColor Foreground}" Margin="0,8,0,4"/>
                            <DockPanel>
                                <AMUI:Button82 Content="Browse..." Click="BrowseSetting_Click" Tag="OatToolsFolder" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" EdgeRoundness="5"/>
                                <TextBox Text="{Binding Settings.OatToolsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="7" Background="{local:UIColor Gray1}" Foreground="{local:UIColor Foreground}" BorderBrush="{local:UIColor Gray3}"/>
                            </DockPanel>
                            <TextBlock Text="Redacted capture file" Foreground="{local:UIColor Foreground}" Margin="0,8,0,4"/>
                            <DockPanel>
                                <AMUI:Button82 Content="Browse..." Click="BrowseSetting_Click" Tag="CaptureFile" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" EdgeRoundness="5"/>
                                <TextBox Text="{Binding Settings.CaptureFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="7" Background="{local:UIColor Gray1}" Foreground="{local:UIColor Foreground}" BorderBrush="{local:UIColor Gray3}"/>
                            </DockPanel>
                            <TextBlock Text="Redacted template file" Foreground="{local:UIColor Foreground}" Margin="0,8,0,4"/>
                            <DockPanel>
                                <AMUI:Button82 Content="Browse..." Click="BrowseSetting_Click" Tag="RedactedTemplateFile" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" EdgeRoundness="5"/>
                                <TextBox Text="{Binding Settings.RedactedTemplateFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="7" Background="{local:UIColor Gray1}" Foreground="{local:UIColor Foreground}" BorderBrush="{local:UIColor Gray3}"/>
                            </DockPanel>
                            <TextBlock Text="Game folder" Foreground="{local:UIColor Foreground}" Margin="0,8,0,4"/>
                            <DockPanel>
                                <AMUI:Button82 Content="Browse..." Click="BrowseSetting_Click" Tag="GameFolder" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" EdgeRoundness="5"/>
                                <TextBox Text="{Binding Settings.GameFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="7" Background="{local:UIColor Gray1}" Foreground="{local:UIColor Foreground}" BorderBrush="{local:UIColor Gray3}"/>
                            </DockPanel>
                            <TextBlock Text="Blender executable" Foreground="{local:UIColor Foreground}" Margin="0,8,0,4"/>
                            <DockPanel>
                                <AMUI:Button82 Content="Browse..." Click="BrowseSetting_Click" Tag="BlenderExecutable" DockPanel.Dock="Right" Width="90" Margin="8,0,0,0" Accent82="{local:UIColor Gray3}" Foreground="{local:UIColor Foreground}" EdgeRoundness="5"/>
                                <TextBox Text="{Binding Settings.BlenderExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="7" Background="{local:UIColor Gray1}" Foreground="{local:UIColor Foreground}" BorderBrush="{local:UIColor Gray3}"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>

<Window x:Class="T6_Workbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:T6_Workbench"
        xmlns:svg="https://github.com/dotnetprojects/SVGImage"
        xmlns:AMUI="clr-namespace:AMUI;assembly=AMUI"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="650" Width="1000" MinHeight="650" MinWidth="1000" AllowsTransparency="True" WindowStyle="None" Background="Transparent" Foreground="White" FontSize="16" 
        FontFamily="./Resources/#SF Pro Rounded Regular" x:Name="T6WorkbenchMainWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

            </ResourceDictionary.MergedDictionaries>
            <x:Static x:Key="empty" Member="sys:String.Empty" />
            <Visibility x:Key="Collapsed">Collapsed</Visibility>
            <Visibility x:Key="Visible">Visible</Visibility>
            <sys:Boolean x:Key="BoolTrue">True</sys:Boolean>
            <sys:Boolean x:Key="BoolFalse">False</sys:Boolean>
            <WindowState x:Key="WndMaximized">Maximized</WindowState>
            <WindowState x:Key="WndNormal">Normal</WindowState>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="#151515" CornerRadius="10">
        <Grid x:Name="MainGrid" Background="Transparent" MouseMove="MainGrid_MouseMove" >
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="ToolBarHead" Background="Transparent" Margin="5,5,5,0" MouseDown="ToolBarHead_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition MinWidth="300" MaxWidth="500"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid Background="Transparent" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" Visibility="{AMUI:ConditionME IF={Binding SelectedIndex, ElementName=TabsControl}, ComparingMode=NotEquals, TO=0, Then={StaticResource Visible}, Else={StaticResource Collapsed}}">
                        <AMUI:Button82 Accent82="#151515" Width="35" Height="35" Margin="5">
                            <svg:SVGImage UriSource="./Resources/dock-left-svgrepo-com.svg" Width="18" Height="18" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:Button82>
                    </StackPanel>
                </Grid>
                <Grid Background="Transparent" Grid.Column="1">
                    <AMUI:TextBox82 x:Name="SearchTextBox"  Margin="5,5,5,5" HintText="Search through assets..." OutlineThickness="1" Background82="#171717" Accent82="#212121" EdgeRoundness="8" Visibility="{AMUI:ConditionME IF={Binding SelectedIndex, ElementName=TabsControl}, ComparingMode=NotEquals, TO=0, Then={StaticResource Visible}, Else={StaticResource Collapsed}}">
                        <AMUI:TextBox82.IconPlaceholder>
                            <svg:SVGImage UriSource="./Resources/search-svgrepo-com.svg" Width="16" Height="16" Margin="10,0,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:TextBox82.IconPlaceholder>
                    </AMUI:TextBox82>
                </Grid>
                <Grid Grid.Column="2" Background="Transparent">
                    <AMUI:Button82 Content="Build" Width="75" HorizontalAlignment="Left" Margin="5" Visibility="{AMUI:ConditionME IF={Binding SelectedIndex, ElementName=TabsControl}, ComparingMode=NotEquals, TO=0, Then={StaticResource Visible}, Else={StaticResource Collapsed}}"/>
                    <StackPanel x:Name="ControlButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                        <AMUI:Button82 x:Name="MinimizeWindowButton" Width="45" Click="MinimizeWindowButton_Click" EdgeRoundness="5,0,0,5" Accent82="#FF151515" Border82="#FF141414" ScaleUpOnHover="False" ScaleDownOnPress="False">
                            <svg:SVGImage UriSource="./Resources/window-minimize-svgrepo-com.svg" Width="13" Height="13" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <svg:SVGImage.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="-180"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </svg:SVGImage.RenderTransform>
                            </svg:SVGImage>
                        </AMUI:Button82>
                        <AMUI:Button82 x:Name="MaximizeWindowButton" Width="45" Click="MaximizeWindowButton_Click" EdgeRoundness="0,0,0,0" Accent82="#FF151515" Border82="#FF141414" ScaleUpOnHover="False" ScaleDownOnPress="False">
                            <svg:SVGImage UriSource="./Resources/window-maximize-svgrepo-com.svg" Width="13" Height="13" Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:Button82>
                        <AMUI:Button82 x:Name="CloseWindowButton"    Width="45" Click="CloseWindowButton_Click"    EdgeRoundness="0,5,5,0" Accent82="#FF151515" Border82="#FF141414" ScaleUpOnHover="False" ScaleDownOnPress="False">
                            <svg:SVGImage UriSource="./Resources/xmark-svgrepo-com.svg" Width="13" Height="13" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </AMUI:Button82>
                    </StackPanel>
                </Grid>
            </Grid>
            <TabControl x:Name="TabsControl" Grid.Row="1" Background="#181818" BorderThickness="0" SelectedIndex="0" TabStripPlacement="Bottom">
                <TabItem x:Name="HomeTab" Header="Home" Visibility="Visible">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="0.1*"/>
                        </Grid.RowDefinitions>
                        <ListView HorizontalAlignment="Right" MinWidth="300" Height="300" Margin="0,0,20,0" Grid.RowSpan="2" VerticalAlignment="Center" Background="#232323" BorderThickness="0">
                            <ListViewItem>Huy</ListViewItem>
                        </ListView>
                        <Border Width="3" Grid.Column="1" Height="400" Background="#1a1a1a" Grid.RowSpan="3" VerticalAlignment="Center"/> <!--divider-->
                        <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Left" Margin="20,0,0,0" Grid.RowSpan="2">
                            <AMUI:Button82 x:Name="NewProjButton" Height="125" Width="125" Margin="5" Accent82="#1D1D1D" Border82="#1D1D1D" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200">
                                <StackPanel>
                                    <svg:SVGImage UriSource="./Resources/add-file-svgrepo-com.svg" Width="45" Height="45" Margin="12,5,5,10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="New project" Foreground="FloralWhite" FontSize="16"/>
                                </StackPanel>
                            </AMUI:Button82>
                            <AMUI:Button82 x:Name="OpenProjButton" Height="125" Width="125" Margin="5" Accent82="#1D1D1D" Border82="#1D1D1D" ScaleUpOnHover="True" ScaleDownOnPress="True" EdgeRoundness="10" ScaleUpAmount="105" ScaleUpAnimDuration="200">
                                <StackPanel>
                                    <svg:SVGImage UriSource="./Resources/folder-open-svgrepo-com.svg" Width="55" Height="55" Margin="12,5,5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open project" Foreground="FloralWhite" FontSize="16"/>
                                </StackPanel>
                            </AMUI:Button82>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="MainTab" Header="Main" Visibility="Visible">
                    <Grid x:Name="MainTabGrid" Background="Transparent" SizeChanged="MainTabGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftColumn" Width="0.3*"/>
                            <ColumnDefinition Width="5"/>
                            <!--Splitter-->
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="#171717" Grid.Column="0">

                        </Grid>
                        <GridSplitter x:Name="MainTabGridSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#171717" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
                        <Grid Background="Transparent" Grid.Column="2">

                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem x:Name="SettingsTab" Header="Settings" Visibility="Visible">
                    <Grid Background="Red">
                        <TextBlock Text="Tab3" Foreground="AntiqueWhite" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
